# Frontend build output. Regenerated by `npm run build` from committed source.
# web/.next is ~202 MB of cache that would conflict on every build and cannot be
# merged; web/out is the generated static bundle the OCaml server serves.
web/.next/
web/out/
web/next-env.d.ts
web/*.tsbuildinfo

