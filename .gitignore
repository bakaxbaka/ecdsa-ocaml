# .gitignore
#
# This file previously contained markdown code fences, literal git conflict
# markers (`<<<<<<< HEAD`, `=======`, `>>>>>>> d919601f...`) and a stray
# PowerShell fragment:
#
#     "@ | Set-Content -Path "D:\ecdsa-ocaml\.gitignore" -Encoding utf8
#
# which had also corrupted the `_build/` rule into `utf8_build/`. The result was
# that nothing on the list was actually ignored: `_build/` was tracked, and every
# build artifact showed up as a change. Rewritten cleanly below.

# ---------------------------------------------------------------- build output
_build/
_dune/
*.install
*.merlin
.merlin

# OCaml compilation artifacts
*.cmi
*.cmo
*.cmx
*.cmxa
*.cma
*.cmxs
*.o
*.a
*.so
*.dll
*.exe
*.obj
*.byte
*.native
*.run

# ---------------------------------------------------------------- dependencies
node_modules/
.opam/
opam-switch/
venv/
.venv/
env/

# ---------------------------------------------------------------- frontend build
web/.next/
web/out/
web/next-env.d.ts
web/*.tsbuildinfo

# ---------------------------------------------------------------- logs and temp
*.log
*.tmp
*.temp
*.swp
*.swo
*~

# ---------------------------------------------------------------- editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- coverage
coverage/
htmlcov/
.coverage
*.coverage

# ---------------------------------------------------------------- environment
.env
.env.local
*.env.local
!.env.example

# ---------------------------------------------------------------- agent / tooling state
# Session-tracking stores. The directory skeletons are kept via .gitkeep, but the
# append-only logs are machine-local and grow without bound.
ltm/store/*.jsonl
ltm/runtime/*.json
ltm/runtime/*.md
ltm/snapshots/*
!ltm/snapshots/.gitkeep
ltm/reports/*
!ltm/reports/.gitkeep

.codeatlas/*.db
.codeatlas/*.db-shm
.codeatlas/*.db-wal
.codeatlas/.mcp-owner
.agent-orchestration/*.db
.agent-orchestration/*.db-shm
.agent-orchestration/*.db-wal
.codemap/*.db
.qwen/

# ---------------------------------------------------------------- large data
# The raw transaction corpus is 7 MB of inputs and the workbench is 74 MB of
# research scratch space. Neither belongs in version control; both stay on disk.
rawtx/
crypto-workbench/chaindata/
crypto-workbench/results/
crypto-workbench/logs/

# ---------------------------------------------------------------- derived-key research output
# The first column of this file is `privkey_hex`: 4.5 MB of private keys derived
# from hypothesised nonce patterns, plus the four address types each key implies.
# Whatever the analysis behind it was for, a list of private keys must not enter
# git history — history is permanent, and this file is regenerable from its inputs.
# The generator script (analysis/attacks/check_all_addresses_tx_history.py) is
# tracked; its output is not.
analysis/attacks/known_nonce_results_btc_addresses.txt
analysis/attacks/*.txt.*
analysis/attacks/*_tx_history.csv
analysis/attacks/*_state.json

# ---------------------------------------------------------------- note on web/
# web/ is deliberately NOT ignored. It is untracked only because it has never been
# committed, not because it is disposable — it has been rewritten twice already
# with nothing recoverable. Its build outputs (web/.next, web/out) are ignored
# above; its source is not.
