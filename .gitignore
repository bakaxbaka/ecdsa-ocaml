*.log
*.tmp
*.temp
*.swp
*.swo
*~

# Editors
.vscode/
.idea/

# Coverage
coverage/
htmlcov/
.coverage
*.coverage

# Environment
.env
.env.local
*.env.*
!.env.example

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Derived-key research output.
# The first column of this file is `privkey_hex`: private keys derived from
# hypothesised nonce patterns, plus four address types per key. It is excluded
# deliberately — private keys must not enter git history, which is permanent and
# is copied into every clone. The generator script is tracked; its output is not.
analysis/attacks/known_nonce_results_btc_addresses.txt
analysis/attacks/*.txt.*
analysis/attacks/*_tx_history.csv
analysis/attacks/*_state.json

# Agent / tooling session state (machine-local, append-only)
ltm/store/*.jsonl
ltm/runtime/*.json
ltm/runtime/*.md
.codeatlas/*.db
.codeatlas/*.db-shm
.codeatlas/*.db-wal
.codeatlas/.mcp-owner
.agent-orchestration/*.db
.agent-orchestration/*.db-shm
.agent-orchestration/*.db-wal
.codemap/*.db
.qwen/

# NOTE — deliberately NOT ignored:
#   rawtx/            the transaction corpus: an input, not regenerable
#   crypto-workbench/ the research workbench: an input, not regenerable
#   btcsrc/           upstream Bitcoin Core C++ reference sources
# Compiler artifacts inside those trees (extract_rsz.cmi, simple_extract.cmo) are
# still caught by the *.cmi / *.cmo rules above, which is correct.
